# terraform.tfvars は gitignore 対象。実値はこのファイルをコピーして作る（mode 600）。
#
# private access 化（ADR-0018）に伴い firewall_allowed_client_ips 変数は削除された。
# Microsoft Entra 認証への切替（ADR-0031）に伴い administrator_password 変数も削除された
# （パスワード認証は無効。既存の terraform.tfvars に同名の行が残っていると undeclared variable の
# 警告が出るので消すこと）。
#
# 必須: Microsoft Entra 管理者（プロジェクト所有者のアカウント）の 2 項目と、アラート通知先。
# いずれも個人のアカウントに紐づく値なのでコミット対象には書かない。
#   az ad signed-in-user show --query "{id:id, upn:userPrincipalName}" -o json
entra_administrator_object_id      = "<object id (GUID)>"
entra_administrator_principal_name = "<userPrincipalName。#EXT# を含む場合はそのまま>"
alert_email_address                = "<notification email>"

# resource_group_name / server_name / administrator_login / log_analytics_daily_quota_gb は default あり。
