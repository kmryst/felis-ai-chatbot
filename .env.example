# ローカル開発用の環境変数サンプル。
# `cp .env.example .env` して使う（.env は .gitignore 済み。コミット禁止）。
# ここに書いてある値はローカル開発専用の既定値で、secret ではない。
# 本物の secret（API キー等）を書いた .env は絶対にコミットしないこと。

# --- docker compose (PostgreSQL) ---
# 未設定なら docker-compose.yml の既定値が使われる
#POSTGRES_USER=felis
#POSTGRES_PASSWORD=local-dev-only
#POSTGRES_DB=felis
# ホスト側公開ポート（既定 5433。別プロジェクトの PostgreSQL と衝突しない値）
#POSTGRES_PORT=5433

# --- backend ---
# backend の必須環境変数。欠けていると起動時に即 fail する
DATABASE_URL=postgresql://felis:local-dev-only@localhost:5433/felis

# 任意（既定値あり）
#LOG_LEVEL=INFO
#DB_CONNECT_TIMEOUT_SECONDS=2

# --- LLM（ADR-0004 / ADR-0009。既定はスタブ） ---
# 実 LLM（Azure OpenAI）を使うときだけ azure-openai にする。
# CI・テストは常にスタブのまま（ADR-0004）
#LLM_PROVIDER=stub
#LLM_TIMEOUT_SECONDS=10
#LLM_MAX_ATTEMPTS=3
#LLM_RETRY_BASE_DELAY_SECONDS=0.5
#LLM_RETRY_MAX_DELAY_SECONDS=8

# --- Azure OpenAI（LLM_PROVIDER=azure-openai のときのみ必須。ADR-0009） ---
# API キーは az cognitiveservices account keys list で取得し、.env にのみ置く
# （コミット禁止。Day 3 で Managed Identity への置き換えを検討）
#AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
#AZURE_OPENAI_API_KEY=<your-api-key>
# 任意（既定値あり）
#AZURE_OPENAI_API_VERSION=2024-10-21
#AZURE_OPENAI_CHAT_DEPLOYMENT=chat
#AZURE_OPENAI_EMBEDDING_DEPLOYMENT=embedding

# CORS で許可する origin（カンマ区切り。既定はローカル frontend）
#CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- frontend ---
# frontend から見た backend の URL（既定 http://localhost:8000）
#NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
